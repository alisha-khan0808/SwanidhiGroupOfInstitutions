# Copy to .env.local and fill in. Without the Supabase keys the public website
# still works (it serves the bundled course data); the admin panel, CRM and
# forms need Supabase.

# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by CRM API routes (create users, HRMS, students, WhatsApp).
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (salary slips) — optional ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Integrations — optional ──
CRON_SECRET=
META_WEBHOOK_SECRET=
WHATSAPP_BOT_SECRET=

# ── Demo login buttons (testing) ──
# Shows "Demo login" buttons on the staff, student, associate and website-admin
# login screens. Create the accounts with `npm run demo:setup`.
# Set to false before going live.
NEXT_PUBLIC_DEMO_LOGIN=true
